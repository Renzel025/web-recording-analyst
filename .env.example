# --- Where this app is reached ---------------------------------------------------
# The link posted to Lark. On the MacBook use its LAN address (System Settings >
# Wi-Fi > Details), e.g. http://192.168.1.20:8000, and start uvicorn with --host 0.0.0.0.
PUBLIC_BASE_URL=http://127.0.0.1:8000
# Shared secret test-automation sends as the X-Auth-Token header on uploads.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_API_TOKEN=
# Log in with Lark (Lark developer console > your app > Credentials & Basic Info).
# Add <PUBLIC_BASE_URL>/auth/lark/callback under Security Settings > Redirect URLs.
# Without these every page, video and chat answers 503.
LARK_APP_ID=
LARK_APP_SECRET=
# Leave empty at first: the first Lark login shows the value to paste here.
LARK_TENANT_KEY=
DISPLAY_TZ=Asia/Manila

# --- Storage -------------------------------------------------------------------------
# Videos, frames and the SQLite database live under DATA_DIR.
DATA_DIR=./data
# local = served by this app at /media; oss = Aliyun OSS (pip install oss2)
STORAGE_BACKEND=local
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# --- Assistant (same setup as ai-avatar-app) ------------------------------------
# Either a Console key or a `claude setup-token` OAuth token.
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=claude-opus-5-5
# Fallback when Claude is unavailable. It can't see the video, only the run's report.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
